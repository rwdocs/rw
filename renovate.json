{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    ".github/workflows/release.yml"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "14 days",
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "npmDedupe"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-npm\\.yml$/"],
      "matchStrings": [
        "image: (?<depName>node):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/codspeed\\.yml$/"],
      "matchStrings": [
        "(?:bins|tool): cargo-codspeed@(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "cargo-codspeed",
      "datasourceTemplate": "crate"
    }
  ],
  "packageRules": [
    {
      "description": "Keep native-binding compatibility tests on Node 22 while updating image patches and digests together",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^22\\./",
      "pinDigests": true,
      "groupName": "native test images"
    },
    {
      "description": "Keep the benchmark build and run jobs on the same CLI version",
      "matchDatasources": ["crate"],
      "matchPackageNames": ["cargo-codspeed"],
      "groupName": "cargo-codspeed"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["napi", "napi-build", "napi-derive"],
      "groupName": "napi-rs crates"
    },
    {
      "description": "eslint no longer depends on @eslint/js, and @eslint/js declares its eslint peer as optional, so npm reports nothing when the two diverge. js.configs.recommended is the base of every TypeScript block in the viewer's ESLint config; keep the pair in one PR so a major lands as one reviewable change",
      "matchManagers": ["npm"],
      "matchPackageNames": ["eslint", "@eslint/js"],
      "groupName": "eslint core"
    },
    {
      "description": "Bump so npm updates edit package.json and package-lock.json together — avoids lockfile-mirror drift in npm workspaces (see renovatebot/renovate#28797)",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "The engines.node constraint is a deliberate minimum (set to match a tooling requirement), not something to auto-bump to the latest release",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchDepTypes": ["action"],
      "pinDigests": true
    }
  ]
}
