{
  "name": "@rwdocs/viewer",
  "version": "0.1.35",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwdocs/rw.git"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "prepublishOnly": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:pack": "npm run build:lib && publint && attw --pack . --profile esm-only --exclude-entrypoints ./embed.css",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node e2e/reset-data.mjs && npm run build && npm run build:lib && playwright test",
    "test:e2e:ui": "node e2e/reset-data.mjs && npm run build && npm run build:lib && playwright test --ui"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.22",
    "rollup-plugin-license": "3.7.1",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/embed.d.ts",
      "import": "./dist/lib/embed.js"
    },
    "./embed.css": "./dist/lib/embed.css"
  },
  "types": "./dist/lib/embed.d.ts",
  "files": [
    "dist/lib/",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "approx-string-match": "^2.0.0"
  }
}
