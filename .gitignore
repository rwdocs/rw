# Lint scope follows this file: ESLint reads it through `includeIgnoreFile`, and
# Prettier and knip skip its entries by default. Listing a directory of real
# source here drops it from all three with no warning.

# Claude
/.claude/settings.local.json
/.worktrees
/.claude/worktrees/

# Playwright output. packages/viewer/.gitignore already lists these, but a run
# started from the repo root writes them here, where only this file is read.
test-results/
playwright-report/
/.mcp.json
/TASKS.md
/docs/superpowers

# Node
node_modules/

# Rust
/target

# napi-rs build artifacts
*.node

# Publish-time generated third-party notice + copied licenses (see
# .github/workflows/publish-npm.yml); never committed, only staged into the
# npm tarballs at publish time.
/packages/core/THIRD-PARTY-RUST.md
/packages/core/npm/*/THIRD-PARTY-RUST.md
/packages/core/npm/*/LICENSE-*

# Release-build generated third-party notice (see .github/dist/build-setup.yml);
# never committed. THIRD-PARTY.md is copied into each release archive by
# `include` in dist-workspace.toml; THIRD-PARTY-RUST.md is an intermediate the
# hook deletes once the two halves are concatenated.
/THIRD-PARTY.md
/THIRD-PARTY-RUST.md

# RW
/.rw
rw.toml
private_key.pem
