# Lint scope follows this file: ESLint reads it through `includeIgnoreFile`, and
# Prettier and knip skip its entries by default. Listing a directory of real
# source here drops it from all three with no warning.

# Claude
/.claude/settings.local.json
/.worktrees
/.claude/worktrees/

# Playwright output. packages/viewer/.gitignore already lists these, but a run
# started from the repo root writes them here, where only this file is read.
test-results/
playwright-report/
/.mcp.json
/TASKS.md
/docs/superpowers

# Node
node_modules/

# Rust
/target

# napi-rs build artifacts
*.node

# RW
/.rw
rw.toml
private_key.pem
